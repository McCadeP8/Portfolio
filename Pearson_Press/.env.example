PEARSON_PRESS_ENV=development
PEARSON_PRESS_TIMEZONE=America/Denver
PEARSON_PRESS_PROFILE_ID=default
PEARSON_PRESS_DATABASE_URL=sqlite:///data/database/pearson_press.db
PEARSON_PRESS_OUTPUT_DIR=data/generated
PEARSON_PRESS_ARCHIVE_DIR=data/archive
PEARSON_PRESS_PRINTER_NAME=
PEARSON_PRESS_ALERT_EMAIL=
PEARSON_PRESS_SECRET_BACKEND=environment

# Claude writes the game stories and previews. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
# Stop calling Claude for the month once this many dollars are spent (default 15).
PEARSON_PRESS_MONTHLY_BUDGET=15
# Only needed if your API key is not scoped to a workspace (starts with wrkspc_).
ANTHROPIC_WORKSPACE_ID=

# Email a PDF copy each morning (Gmail). The password is a Google *app password*:
# myaccount.google.com/apppasswords (needs 2-Step Verification on).
PEARSON_PRESS_SMTP_USER=
PEARSON_PRESS_SMTP_PASSWORD=
# Where to send it; blank means the same Gmail address.
PEARSON_PRESS_EMAIL_TO=
