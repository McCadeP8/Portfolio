# Local data is used when these are omitted.
SBC_DATA_ROOT=.
SBC_RUNTIME_ROOT=.runtime

# Optional public object-storage prefix, for example:
# https://data.example.com/sbc
SBC_DATA_BASE_URL=
SBC_REMOTE_CACHE_SECONDS=300

# off = current production behavior; shadow = collect only; live = publishable.
SBC_LIVE_MODE=off
SBC_LIVE_CACHE_SECONDS=15
SBC_HTTP_TIMEOUT_SECONDS=30
SBC_PARQUET_ROW_GROUP_SIZE=50000

# Optional overnight completion/failure notification.
DISCORD_WEBHOOK_URL=
