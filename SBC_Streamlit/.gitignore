.streamlit_cache/
.venv/
__pycache__/
*.py[cod]
data_snapshots/*.parquet
data_snapshots/nba_boxscore_cache/
data_snapshots/pbp/**/*.parquet
data_snapshots/pbp/**/*.csv
data_snapshots/pbp/checkpoints_*/
# Every season archive (pbp_stat_events_YYYYYY.parquet) is committed, including
# future ones the nightly job creates; test slices and checkpoints stay ignored.
!data_snapshots/pbp/pbp_stat_events_[0-9][0-9][0-9][0-9][0-9][0-9].parquet

# Local Codex-generated artifact workspaces and dependency junctions.
.codex_artifacts/
.codex_tmp/
.runtime/
.env
*.log
data_snapshots/_runs/*.json
!data_snapshots/_runs/latest.json
